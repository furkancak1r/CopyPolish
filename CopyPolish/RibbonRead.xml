<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
  <ribbon>
    <tabs>
      <tab id="CopyPolishPrimaryTab" label="CopyPolish">
        <group id="CopyPolishReadGroup" label="CopyPolish Araçları">
          <button id="btnImproveRead"
                  label="İyileştir"
                  size="large"
                  imageMso="ReviewingPane"
                  onAction="OnImproveSelectionClick"
                  getEnabled="GetSelectionDependentEnabled"/>
          <button id="btnTranslateRead"
                  label="Çeviri"
                  size="large"
                  imageMso="Translate"
                  onAction="OnTranslateTrEnClick"
                  getEnabled="GetSelectionDependentEnabled"/>
          <button id="btnSearchRead"
                  label="Ara"
                  size="large"
                  imageMso="SearchToolsSearch"
                  onAction="OnSearchClick"/>
          <button id="btnSettingsRead"
                  label="Ayarlar"
                  size="large"
                  imageMso="ApplicationOptionsDialog"
                  onAction="OnCopyPolishSettingsClick"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
  
