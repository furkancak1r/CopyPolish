<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
  <ribbon>
    <tabs>
      <tab id="CopyPolishPrimaryTab" label="CopyPolish">
        <group id="CopyPolishMainGroup" label="CopyPolish Araçları">
          <button id="btnImproveExplorer"
                  label="İyileştir"
                  size="large"
                  imageMso="ReviewingPane"
                  onAction="OnImproveSelectionClick"
                  getEnabled="IsExplorerSelectionEnabled_Final"/>
          <button id="btnTranslateExplorer"
                  label="Çeviri"
                  size="large"
                  imageMso="Translate"
                  onAction="OnTranslateTrEnClick"
                  getEnabled="IsExplorerSelectionEnabled_Final"/>
          <button id="btnSearchExplorer"
                  label="Ara"
                  size="large"
                  showImage="true"
                  imageMso="Search"
                  onAction="OnSearchClick"/>
          <button id="btnSettingsExplorer"
                  label="Ayarlar"
                  size="large"
                  imageMso="ApplicationOptionsDialog"
                  onAction="OnCopyPolishSettingsClick"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
  
