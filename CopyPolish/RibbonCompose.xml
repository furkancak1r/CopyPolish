<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
  <ribbon>
    <tabs>
      <tab id="CopyPolishPrimaryTab" label="CopyPolish">
        <group id="CopyPolishComposeGroup" label="CopyPolish Araçları">
          <button id="btnImproveCompose"
                  label="İyileştir"
                  size="large"
                  imageMso="ReviewingPane"
                  onAction="OnImproveSelectionClick"
                  getEnabled="GetSelectionDependentEnabled"/>
          <button id="btnTranslateCompose"
                  label="Çeviri"
                  size="large"

                  imageMso="Translate"
                  onAction="OnTranslateTrEnClick"
                  getEnabled="GetSelectionDependentEnabled"/>
          <button id="btnSettingsCompose"
                  label="Ayarlar"
                  size="large"
                  imageMso="ApplicationOptionsDialog"
                  onAction="OnCopyPolishSettingsClick"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
  